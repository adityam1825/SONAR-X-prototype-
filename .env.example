# SONAR-X Environment Variables
# Copy this file to .env and fill in values

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://sonarx:sonarx_password@localhost:5432/sonarx_db
DB_NAME=sonarx_db
DB_USER=sonarx
DB_PASSWORD=sonarx_password
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media / Uploads
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=100

# AI Engine
AI_MODEL_PATH=./ai/models/sonarx_yolo.pt
DEMO_MODE=true
YOLO_CONFIDENCE_THRESHOLD=0.35

# Temporal / Spatial
TEMPORAL_SEARCH_RADIUS=500
FINGERPRINT_SIMILARITY_THRESHOLD=0.65

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional — for Celery)
REDIS_URL=redis://localhost:6379/0

# Software version
SONARX_VERSION=0.1.0-prototype
